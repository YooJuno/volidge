#!/bin/zsh
set -u

target_volume="$3"
console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
  console_uid="$(/usr/bin/id -u "$console_user")"
  /bin/launchctl asuser "$console_uid" /usr/bin/osascript \
    -e 'tell application id "com.juno.vol" to quit' >/dev/null 2>&1 || true
fi

for _ in {1..25}; do
  if ! /usr/bin/pgrep -f '/(Applications|Users/[^/]+/Applications)/Volidge\.app/Contents/MacOS/Vol$' >/dev/null 2>&1; then
    break
  fi
  /bin/sleep 0.2
done
/usr/bin/pkill -TERM -f '/(Applications|Users/[^/]+/Applications)/Volidge\.app/Contents/MacOS/Vol$' >/dev/null 2>&1 || true

/bin/rm -rf "$target_volume/Library/Audio/Plug-Ins/HAL/VolDevice.driver"
/bin/rm -rf "$target_volume/Library/Audio/Plug-Ins/HAL/Volidge.driver"
/bin/rm -rf "$target_volume/Applications/Vol.app"
exit 0
