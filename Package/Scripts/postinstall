#!/bin/zsh
set -u

/usr/bin/killall coreaudiod >/dev/null 2>&1 || true

for _ in {1..20}; do
  if /usr/sbin/system_profiler SPAudioDataType 2>/dev/null | /usr/bin/grep -q 'Volidge:'; then
    break
  fi
  /bin/sleep 0.25
done

console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
  console_uid="$(/usr/bin/id -u "$console_user")"
  for legacy_app in "/Users/$console_user/Applications/Vol.app" "/Users/$console_user/Applications/Volidge.app"; do
    if [[ -d "$legacy_app" ]]; then
      bundle_identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$legacy_app/Contents/Info.plist" 2>/dev/null || true)"
      if [[ "$bundle_identifier" == "com.juno.vol" ]]; then
        /bin/rm -rf "$legacy_app"
      fi
    fi
  done
  /bin/launchctl asuser "$console_uid" /usr/bin/open -n "$3/Applications/Volidge.app" >/dev/null 2>&1 || true
fi
exit 0
